#include<iostream>
using namespace std;
class Rectangle{
    int length; int width;
    public:
    Rectangle(){
        length=0; width=0; }
    Rectangle(int l, int w){
        length=l; width=w; }
        void display(){
            cout<<"\n length= "<<length;
            cout<<"\n width= "<<width;}
          friend void area(Rectangle obj);      
};
void area(Rectangle obj){
    cout<<"\n Area of rectangle= "<<(obj.width*obj.length);
}
int main(){
    Rectangle r1, r2(2, 6);
    r1.display();
    area(r1);
    r2.display();
    area(r2);
    return 0;
}
