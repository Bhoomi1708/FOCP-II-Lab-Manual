//Operator Overiding
#include<iostream>
using namespace std;
class shape{
    public:
    void area(){ cout<<"\n no dimensions, no area";   }
    void perimeter(){ cout<<"\n no dimensions, no perimeter";    }
    void dimension(){cout<<"\n nothing to display ";}
    void display(){cout<<"\n ***** we are 2d shapes*****";}    
};
class square: public shape{
    int side;
    public:
    square(int s=0) {side=s;}
    void area()//overiding
    {cout<<"\n area= "<<side*side;}
    void perimeter()//overiding
    {cout<<"\n perimeter= "<<4*side;}
    void dimension()//overiding
    {cout<<"\n side is "<<side;}
};
int main(){
    shape s1;
    square s, ss(12);
    ss.area(); ss.perimeter(); ss.dimension();
    ss.display();
    return 0;
}
