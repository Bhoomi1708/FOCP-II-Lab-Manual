//hybrid inheritance
#include<iostream>
using namespace std;
class A{
    int a;
    public:
    A():a(100)
    {cout<<"\n A constructor called";}
    ~A()
    {cout<<"\n A destructor called";}
    void display_A(){
    cout<<"\n value of a: "<<a;
    }
};
class B: virtual public A{
    int b;
    public:
    B():b(250)
    {cout<<"\n B constructor called";}
    ~B()
    {cout<<"\n B destructor called";}
    void display_B(){
    cout<<"\n value of b: "<<b;
    }
};
class C: virtual public A{
    int c;
    public:
    C():c(120)
    {cout<<"\n C constructor called";}
    ~C()
    {cout<<"\n C destructor called";}
    void display_C(){
    cout<<"\n value of c: "<<c;
    }
};
class D: public B, public C{
    int d;
    public:
    D():d(1500)
    {cout<<"\n D constructor called";}
    ~D()
    {cout<<"\n D destructor called";}
    void display_D(){
    display_A();
    display_B();
    display_C();
    cout<<"\n value of d: "<<d;
    }
};

int main(){
    D d1;
    d1.display_D();
    return 0;
}
