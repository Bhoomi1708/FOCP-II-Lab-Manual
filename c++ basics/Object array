#include<iostream>
using namespace std;
class A{
    int height; int length; int breadth;
    public:
    A(double l=100, double h=10, double b=15){
        //cout<<"\nA constructor called";
        length= l; height=h; breadth= b;
    }
    double volume(){
        return length*breadth*height;
    }
    void display(){
        cout<<"\nlength= "<<length<<"\nbreadth= "<<breadth<<"\nheight= "<<height;
        cout<<"\nvolume= "<<volume();
    }
};
int main(){
    A a[5]= {A(1,2,3),A(4,5,6),A(6,7,8)};
    //A*obj_arr= new A[5]{A(1,2,3)}
    for(int i=0; i<5; i++){
        cout<<"\n*****"<<i<<"th object *****";
        a[i].display();
    }
    return 0;
}
