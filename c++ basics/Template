//template
#include<iostream>
using namespace std;
template<typename T>
T add(T v1, T v2)  
{return (v1+v2);}
int main(){
    cout<<add<int>(10,20)<<endl; //Now T will be replaced by int
    cout<<add<float>(39.45, 34.5)<<endl;  //T will have float
    cout<<add<string>("Hello", " World");  //T will have string
    return 0;
}
